--- a/packages/core/src/zig/build.zig
+++ b/packages/core/src/zig/build.zig
@@ -190,8 +190,13 @@
     switch (target.result.os.tag) {
         .macos => addMacOSSystemLibraries(b, artifact, macos_sdk_path.?),
         .linux => {
-            artifact.linkSystemLibrary("dl");
-            artifact.linkSystemLibrary("pthread");
+            // CrossForge patch: Android ships bionic, where dl/pthread live inside
+            // libc — linking them by name fails ("unable to find dynamic system
+            // library 'dl'"). Zig reports Android as .linux/.android, so guard on abi.
+            if (target.result.abi != .android) {
+                artifact.linkSystemLibrary("dl");
+                artifact.linkSystemLibrary("pthread");
+            }
         },
         else => {},
     }
